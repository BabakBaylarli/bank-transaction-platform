# Copy to .env and adjust. docker compose reads .env automatically.
# Defaults in docker-compose.yml are for LOCAL DEVELOPMENT ONLY.

# HMAC key for JWTs (>= 32 characters). Generate one with:  openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars

POSTGRES_DB=bank
POSTGRES_USER=bank
POSTGRES_PASSWORD=replace-me

# Demo users seeded by the "dev" profile (admin / alice / bob)
SEED_ADMIN_PASSWORD=Admin123!
SEED_CUSTOMER_PASSWORD=Customer123!
