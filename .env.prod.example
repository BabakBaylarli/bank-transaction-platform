# Production configuration for docker-compose.prod.yml
#   cp .env.prod.example .env && nano .env
# Generate secrets with:  openssl rand -base64 48 | tr -d '\n/+=' | cut -c1-48
# NEVER commit the filled-in .env (it is git-ignored).

# ---- public address ---------------------------------------------------------------
# Your (free) DuckDNS hostname, e.g. mybank.duckdns.org. Caddy gets a Let's Encrypt certificate for it.
DOMAIN=yourname.duckdns.org
# Let's Encrypt sends certificate expiry notices here
ACME_EMAIL=you@example.com

# ---- secrets (all required) --------------------------------------------------------
# HMAC key for JWTs, at least 32 characters
JWT_SECRET=
POSTGRES_PASSWORD=
# Basic-auth login for https://<DOMAIN>/kibana/ (plain text here; Caddy hashes it at start-up)
KIBANA_USER=admin
KIBANA_PASSWORD=

# ---- demo users (shown on the login page while DEMO_MODE=true) ------------------------
DEMO_MODE=true
SEED_ADMIN_PASSWORD=Admin123!
SEED_CUSTOMER_PASSWORD=Customer123!

# ---- optional ---------------------------------------------------------------------
POSTGRES_DB=bank
POSTGRES_USER=bank
# requests per client IP per minute
RATE_LIMIT_AUTH_PER_MIN=10
RATE_LIMIT_TRANSFERS_PER_MIN=30
# DuckDNS token: if set, deploy.sh installs a cron job that keeps the DNS record pointing at this VM
DUCKDNS_TOKEN=
# Nightly demo reset time (cron syntax, server time zone). Empty disables the reset.
DEMO_RESET_CRON=0 3 * * *

# Local testing only (plain HTTP on http://localhost, no certificates):
# DOMAIN=localhost
# SITE_ADDRESS=http://localhost
# PUBLIC_ORIGIN=http://localhost
