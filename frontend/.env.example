# Base URL of the API. Leave empty to use the same origin (Vite proxy in dev, Caddy in production).
VITE_API_BASE_URL=
# Where the admin page links to Kibana.
VITE_KIBANA_URL=http://localhost:5601/app/dashboards#/view/transactions-overview
# Show the demo credentials banner on the login page.
VITE_DEMO_MODE=true
VITE_DEMO_CUSTOMER_PASSWORD=Customer123!
VITE_DEMO_ADMIN_PASSWORD=Admin123!
