# Static file server for the built SPA (runs behind the public reverse proxy).
{
	admin off
	auto_https off
}

:80 {
	root * /srv
	encode zstd gzip

	respond /healthz 200

	# hashed assets never change -> cache forever; index.html must always be revalidated
	@assets path /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"
	header /index.html Cache-Control "no-cache"

	# client-side routing: unknown paths fall back to index.html
	try_files {path} /index.html
	file_server
}
